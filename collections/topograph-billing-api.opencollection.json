{
  "opencollection": "1.0.0",
  "info": {
    "name": "Topograph Billing API",
    "version": "0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Billing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the current account credit balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.topograph.co/v2/billing/balance",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns the account's remaining credit balance, a derived health status, the auto-topup posture, and the configured low-balance thresholds. This is the remaining balance — for consumption use GET /v2/workspaces/usage."
        }
      ]
    }
  ],
  "bundled": true
}